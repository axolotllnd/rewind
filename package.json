{
  "name": "rewind-recorder",
  "version": "0.2.7",
  "private": true,
  "description": "Windows screen recording and instant replay",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "node scripts/package.cjs",
    "build:native": "node scripts/build-native.cjs",
    "build:sounds": "node scripts/build-sounds.cjs",
    "installer": "node scripts/installer.cjs",
    "test:code": "node --test tests/config.test.cjs tests/replay.test.cjs tests/shared-shortcuts.test.cjs tests/audio-processing.test.cjs tests/save-status.test.cjs tests/recorder.test.cjs tests/sounds.test.cjs tests/distribution.test.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@phosphor-icons/react": "^2.1.0",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/generator": "^8.0.10",
    "@babel/parser": "^8.0.10",
    "@babel/traverse": "^8.0.10",
    "@babel/types": "^8.0.10",
    "electron": "^42.0.0",
    "vite": "^7.1.0"
  },
  "author": "axolotllnd",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/axolotllnd/rewind.git"
  },
  "homepage": "https://github.com/axolotllnd/rewind",
  "bugs": {
    "url": "https://github.com/axolotllnd/rewind/issues"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.25.0"
}
